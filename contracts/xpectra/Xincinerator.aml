// SPDX-License-Identifier: MIT

//| Xincinerator
//| Burn address for Xpectrum collections.
//|
//| model    a contract with no entry points that move anything, so a token transferred here stays here
//| custody  holds burned tokens permanently; there is no owner and no outbound call
//| payout   none
//| privacy  every token sent here is public state on its collection
//| units    time in epochs
//| version  1.0.0
//| license  MIT

contract Xincinerator {

  state {
    deployed_epoch: u128
  }

  constructor() {
    self.deployed_epoch = epoch
  }

  //| Contract version.
  //| out      1
  view fn get_version(): u128 {
    return 1
  }

  //| Epoch this contract was deployed in.
  //| out      epoch
  view fn get_deployed_epoch(): u128 {
    return self.deployed_epoch
  }
}
