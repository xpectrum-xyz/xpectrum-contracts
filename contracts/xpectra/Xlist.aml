// SPDX-License-Identifier: FSL-1.1-MIT

//| Xlist_v2
//| Two-phase allowlist bound to one collection. Xpectra's allowlist, and the one XuperFactory v2.0.0 deploys.
//|
//| model    phase 0 is guaranteed, phase 1 is first come; membership is 1 or 0 per address per phase
//| custody  holds no tokens and no OCT
//| payout   none
//| privacy  every member address is public state and can be paged with get_whitelist_page
//| roles    the operator is the deployer and edits the lists; the bound collection is the only caller is_whitelisted answers
//| version  2.0.0
//| license  FSL-1.1-MIT, MIT from 2028-10-30

contract Xlist_v2 {

  state {
    operator:        address
    collection_addr: address
    initialized:     int
    lists:           map[int]map[address]int

    // member enumeration per phase, positions stored + 1 so 0 means not a member
    member_index: map[int]map[int]address
    member_pos:   map[int]map[address]int
    member_count: map[int]int
  }

  constructor() {
    self.operator    = caller
    self.initialized = 0
  }

  private fn only_operator() {
    require(caller == self.operator, "xlist: not operator")
  }

  private fn only_initialized() {
    require(self.initialized == 1, "xlist: not initialized")
  }

  private fn _index_add(phase_num: int, addr: address) {
    if self.member_pos[phase_num][addr] == 0 {
      let idx = self.member_count[phase_num]
      self.member_index[phase_num][idx]  = addr
      self.member_pos[phase_num][addr]   = idx + 1
      self.member_count[phase_num]       = idx + 1
    }
  }

  private fn _index_remove(phase_num: int, addr: address) {
    let pos1 = self.member_pos[phase_num][addr]
    if pos1 != 0 {
      let pos  = pos1 - 1
      let last = self.member_count[phase_num] - 1
      if pos != last {
        let last_addr = self.member_index[phase_num][last]
        self.member_index[phase_num][pos] = last_addr
        self.member_pos[phase_num][last_addr] = pos + 1
      }
      self.member_count[phase_num]     = last
      self.member_pos[phase_num][addr] = 0
    }
  }

  //| Binds the list to its collection. Callable once.
  //| who      the operator
  //| in       collection  the collection
  //| out      true
  fn init(collection: address): bool {
    require(self.initialized == 0, "xlist: already initialized")
    only_operator()
    require(is_address(collection) && collection != 0, "xlist: invalid collection")
    self.collection_addr = collection
    self.initialized     = 1
    return true
  }

  //| Hands the operator role to a new address.
  //| who      the operator
  //| in       new_operator  the new operator
  //| out      true
  fn set_operator(new_operator: address): bool {
    only_operator()
    require(is_address(new_operator) && new_operator != 0, "xlist: invalid address")
    self.operator = new_operator
    return true
  }

  //| Rebinds the list to a different collection.
  //| who      the operator
  //| in       new_collection  the collection
  //| out      true
  fn update_collection(new_collection: address): bool {
    only_initialized()
    only_operator()
    require(is_address(new_collection) && new_collection != 0, "xlist: invalid address")
    self.collection_addr = new_collection
    return true
  }

  //| Adds an address to a phase.
  //| who      the operator
  //| in       phase_num  0 guaranteed, 1 first come
  //| in       addr       the address
  //| out      true
  fn add(phase_num: int, addr: address): bool {
    only_initialized()
    only_operator()
    require(phase_num == 0 || phase_num == 1, "xlist: invalid phase")
    require(is_address(addr) && addr != 0,    "xlist: invalid address")
    _index_add(phase_num, addr)
    self.lists[phase_num][addr] = 1
    return true
  }

  //| Removes an address from a phase.
  //| who      the operator
  //| in       phase_num  0 guaranteed, 1 first come
  //| in       addr       the address
  //| out      true
  fn remove(phase_num: int, addr: address): bool {
    only_initialized()
    only_operator()
    require(phase_num == 0 || phase_num == 1, "xlist: invalid phase")
    require(is_address(addr) && addr != 0,    "xlist: invalid address")
    _index_remove(phase_num, addr)
    self.lists[phase_num][addr] = 0
    return true
  }

  //| Adds up to 20 addresses to a phase.
  //| who      the operator
  //| in       phase_num        0 guaranteed, 1 first come
  //| in       addr_0..addr_19  addresses; invalid or zero entries are skipped
  //| out      number of entries written
  fn add_batch(phase_num: int, addr_0: address, addr_1: address, addr_2: address, addr_3: address, addr_4: address, addr_5: address, addr_6: address, addr_7: address, addr_8: address, addr_9: address, addr_10: address, addr_11: address, addr_12: address, addr_13: address, addr_14: address, addr_15: address, addr_16: address, addr_17: address, addr_18: address, addr_19: address): int {
    only_initialized()
    only_operator()
    require(phase_num == 0 || phase_num == 1, "xlist: invalid phase")

    let count = 0
    if is_address(addr_0)  && addr_0  != 0 { _index_add(phase_num, addr_0)  self.lists[phase_num][addr_0]  = 1  count += 1 }
    if is_address(addr_1)  && addr_1  != 0 { _index_add(phase_num, addr_1)  self.lists[phase_num][addr_1]  = 1  count += 1 }
    if is_address(addr_2)  && addr_2  != 0 { _index_add(phase_num, addr_2)  self.lists[phase_num][addr_2]  = 1  count += 1 }
    if is_address(addr_3)  && addr_3  != 0 { _index_add(phase_num, addr_3)  self.lists[phase_num][addr_3]  = 1  count += 1 }
    if is_address(addr_4)  && addr_4  != 0 { _index_add(phase_num, addr_4)  self.lists[phase_num][addr_4]  = 1  count += 1 }
    if is_address(addr_5)  && addr_5  != 0 { _index_add(phase_num, addr_5)  self.lists[phase_num][addr_5]  = 1  count += 1 }
    if is_address(addr_6)  && addr_6  != 0 { _index_add(phase_num, addr_6)  self.lists[phase_num][addr_6]  = 1  count += 1 }
    if is_address(addr_7)  && addr_7  != 0 { _index_add(phase_num, addr_7)  self.lists[phase_num][addr_7]  = 1  count += 1 }
    if is_address(addr_8)  && addr_8  != 0 { _index_add(phase_num, addr_8)  self.lists[phase_num][addr_8]  = 1  count += 1 }
    if is_address(addr_9)  && addr_9  != 0 { _index_add(phase_num, addr_9)  self.lists[phase_num][addr_9]  = 1  count += 1 }
    if is_address(addr_10) && addr_10 != 0 { _index_add(phase_num, addr_10) self.lists[phase_num][addr_10] = 1  count += 1 }
    if is_address(addr_11) && addr_11 != 0 { _index_add(phase_num, addr_11) self.lists[phase_num][addr_11] = 1  count += 1 }
    if is_address(addr_12) && addr_12 != 0 { _index_add(phase_num, addr_12) self.lists[phase_num][addr_12] = 1  count += 1 }
    if is_address(addr_13) && addr_13 != 0 { _index_add(phase_num, addr_13) self.lists[phase_num][addr_13] = 1  count += 1 }
    if is_address(addr_14) && addr_14 != 0 { _index_add(phase_num, addr_14) self.lists[phase_num][addr_14] = 1  count += 1 }
    if is_address(addr_15) && addr_15 != 0 { _index_add(phase_num, addr_15) self.lists[phase_num][addr_15] = 1  count += 1 }
    if is_address(addr_16) && addr_16 != 0 { _index_add(phase_num, addr_16) self.lists[phase_num][addr_16] = 1  count += 1 }
    if is_address(addr_17) && addr_17 != 0 { _index_add(phase_num, addr_17) self.lists[phase_num][addr_17] = 1  count += 1 }
    if is_address(addr_18) && addr_18 != 0 { _index_add(phase_num, addr_18) self.lists[phase_num][addr_18] = 1  count += 1 }
    if is_address(addr_19) && addr_19 != 0 { _index_add(phase_num, addr_19) self.lists[phase_num][addr_19] = 1  count += 1 }
    return count
  }

  //| Removes up to 20 addresses from a phase.
  //| who      the operator
  //| in       phase_num        0 guaranteed, 1 first come
  //| in       addr_0..addr_19  addresses; invalid or zero entries are skipped
  //| out      number removed
  fn remove_batch(phase_num: int, addr_0: address, addr_1: address, addr_2: address, addr_3: address, addr_4: address, addr_5: address, addr_6: address, addr_7: address, addr_8: address, addr_9: address, addr_10: address, addr_11: address, addr_12: address, addr_13: address, addr_14: address, addr_15: address, addr_16: address, addr_17: address, addr_18: address, addr_19: address): int {
    only_initialized()
    only_operator()
    require(phase_num == 0 || phase_num == 1, "xlist: invalid phase")

    let count = 0
    if is_address(addr_0)  && addr_0  != 0 && self.lists[phase_num][addr_0]  == 1 { _index_remove(phase_num, addr_0)  self.lists[phase_num][addr_0]  = 0  count += 1 }
    if is_address(addr_1)  && addr_1  != 0 && self.lists[phase_num][addr_1]  == 1 { _index_remove(phase_num, addr_1)  self.lists[phase_num][addr_1]  = 0  count += 1 }
    if is_address(addr_2)  && addr_2  != 0 && self.lists[phase_num][addr_2]  == 1 { _index_remove(phase_num, addr_2)  self.lists[phase_num][addr_2]  = 0  count += 1 }
    if is_address(addr_3)  && addr_3  != 0 && self.lists[phase_num][addr_3]  == 1 { _index_remove(phase_num, addr_3)  self.lists[phase_num][addr_3]  = 0  count += 1 }
    if is_address(addr_4)  && addr_4  != 0 && self.lists[phase_num][addr_4]  == 1 { _index_remove(phase_num, addr_4)  self.lists[phase_num][addr_4]  = 0  count += 1 }
    if is_address(addr_5)  && addr_5  != 0 && self.lists[phase_num][addr_5]  == 1 { _index_remove(phase_num, addr_5)  self.lists[phase_num][addr_5]  = 0  count += 1 }
    if is_address(addr_6)  && addr_6  != 0 && self.lists[phase_num][addr_6]  == 1 { _index_remove(phase_num, addr_6)  self.lists[phase_num][addr_6]  = 0  count += 1 }
    if is_address(addr_7)  && addr_7  != 0 && self.lists[phase_num][addr_7]  == 1 { _index_remove(phase_num, addr_7)  self.lists[phase_num][addr_7]  = 0  count += 1 }
    if is_address(addr_8)  && addr_8  != 0 && self.lists[phase_num][addr_8]  == 1 { _index_remove(phase_num, addr_8)  self.lists[phase_num][addr_8]  = 0  count += 1 }
    if is_address(addr_9)  && addr_9  != 0 && self.lists[phase_num][addr_9]  == 1 { _index_remove(phase_num, addr_9)  self.lists[phase_num][addr_9]  = 0  count += 1 }
    if is_address(addr_10) && addr_10 != 0 && self.lists[phase_num][addr_10] == 1 { _index_remove(phase_num, addr_10) self.lists[phase_num][addr_10] = 0  count += 1 }
    if is_address(addr_11) && addr_11 != 0 && self.lists[phase_num][addr_11] == 1 { _index_remove(phase_num, addr_11) self.lists[phase_num][addr_11] = 0  count += 1 }
    if is_address(addr_12) && addr_12 != 0 && self.lists[phase_num][addr_12] == 1 { _index_remove(phase_num, addr_12) self.lists[phase_num][addr_12] = 0  count += 1 }
    if is_address(addr_13) && addr_13 != 0 && self.lists[phase_num][addr_13] == 1 { _index_remove(phase_num, addr_13) self.lists[phase_num][addr_13] = 0  count += 1 }
    if is_address(addr_14) && addr_14 != 0 && self.lists[phase_num][addr_14] == 1 { _index_remove(phase_num, addr_14) self.lists[phase_num][addr_14] = 0  count += 1 }
    if is_address(addr_15) && addr_15 != 0 && self.lists[phase_num][addr_15] == 1 { _index_remove(phase_num, addr_15) self.lists[phase_num][addr_15] = 0  count += 1 }
    if is_address(addr_16) && addr_16 != 0 && self.lists[phase_num][addr_16] == 1 { _index_remove(phase_num, addr_16) self.lists[phase_num][addr_16] = 0  count += 1 }
    if is_address(addr_17) && addr_17 != 0 && self.lists[phase_num][addr_17] == 1 { _index_remove(phase_num, addr_17) self.lists[phase_num][addr_17] = 0  count += 1 }
    if is_address(addr_18) && addr_18 != 0 && self.lists[phase_num][addr_18] == 1 { _index_remove(phase_num, addr_18) self.lists[phase_num][addr_18] = 0  count += 1 }
    if is_address(addr_19) && addr_19 != 0 && self.lists[phase_num][addr_19] == 1 { _index_remove(phase_num, addr_19) self.lists[phase_num][addr_19] = 0  count += 1 }
    return count
  }

  //| Clears every member of a phase in one call. Cost grows with the list.
  //| who      the operator
  //| in       phase_num  0 guaranteed, 1 first come
  //| out      number cleared
  fn nuke(phase_num: int): int {
    only_initialized()
    only_operator()
    require(phase_num == 0 || phase_num == 1, "xlist: invalid phase")
    let total = self.member_count[phase_num]
    let i = 0
    for i in 0..total {
      let addr = self.member_index[phase_num][i]
      self.lists[phase_num][addr]      = 0
      self.member_pos[phase_num][addr] = 0
    }
    self.member_count[phase_num] = 0
    return total
  }

  //| Membership check for the bound collection. Any other caller reads 0.
  //| in       phase_num  0 guaranteed, 1 first come
  //| in       addr       the address
  //| out      1 member, 0 not
  view fn is_whitelisted(phase_num: int, addr: address): int {
    if caller != self.collection_addr {
      return 0
    }
    if phase_num == 0 || phase_num == 1 {
      return self.lists[phase_num][addr]
    }
    return 0
  }

  //| Membership check open to any caller.
  //| in       phase_num  0 guaranteed, 1 first come
  //| in       addr       the address
  //| out      1 member, 0 not
  view fn check(phase_num: int, addr: address): int {
    if phase_num == 0 || phase_num == 1 {
      return self.lists[phase_num][addr]
    }
    return 0
  }

  //| Page of a phase's members.
  //| in       phase_num  0 guaranteed, 1 first come
  //| in       offset     first index
  //| in       limit      members wanted, at most 200
  //| out      total|addr|addr...
  view fn get_whitelist_page(phase_num: int, offset: int, limit: int): string {
    let total = self.member_count[phase_num]
    let out = to_string(total)
    if total == 0 { return out }
    let safe_limit = limit
    if safe_limit > 200 { safe_limit = 200 }
    let end = offset + safe_limit
    if end > total { end = total }
    let n = end - offset
    let i = 0
    for i in 0..n {
      out = concat(out, "|")
      out = concat(out, to_string(self.member_index[phase_num][offset + i]))
    }
    return out
  }

  //| Number of members in a phase.
  //| in       phase_num  0 guaranteed, 1 first come
  //| out      count
  view fn get_member_count(phase_num: int): int {
    return self.member_count[phase_num]
  }

  //| Bound collection.
  //| out      address
  view fn get_collection(): address {
    return self.collection_addr
  }

  //| Current operator.
  //| out      address
  view fn get_operator(): address {
    return self.operator
  }
}
