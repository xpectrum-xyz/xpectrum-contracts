// SPDX-License-Identifier: FSL-1.1-MIT

//| XuperFactory
//| Creates a fully configured Xcollection in one transaction.
//|
//| model    the collection takes every setting as a constructor argument, so it never exists half set up
//| model    the platform address, the shared list contract and the Xpectra collection come from this contract's state, never from the caller
//| model    every collection owns its own lists in Xlist, so nothing about a sale is held by a key outside it
//| model    deploy reads its arguments from consecutive registers starting at the first, so it is only ever called with a function's own parameters in order
//| custody  holds launch fees until withdraw; a launch budget passes straight through to the launch key
//| payout   withdraw sends the whole balance to the platform address
//| privacy  nothing is private
//| units    amounts in micro-OCT (1 OCT = 1,000,000), time in epochs
//| version  4.0.0
//| license  FSL-1.1-MIT, MIT from 2028-10-30

contract XuperFactory {

  const XCOLLECTION_BYTECODE: string = ""

  event CollectionCreated(index: u128, collection: address, owner: address, launcher: address, fee: u128, budget: u128)
  event LaunchFeeSet(fee: u128)
  event PlatformSet(platform: address)
  event XlistSet(xlist: address)
  event OwnershipProposed(owner: address, proposed: address)
  event OwnershipTransferred(old_owner: address, new_owner: address)

  state {
    owner: address
    pending_owner: address
    platform: address
    xlist: address
    xpectra: address
    launch_fee: u128
    count: u128
    collections: map[u128]address
    count_of: map[address]u128
    collection_of: map[address]map[u128]address
    by_launcher: map[address]map[address]address
  }

  constructor(xlist_addr: address, xpectra_addr: address) {
    assert_address(xlist_addr)
    assert_address(xpectra_addr)
    self.owner = caller
    self.pending_owner = caller
    self.platform = caller
    self.xlist = xlist_addr
    self.xpectra = xpectra_addr
    self.launch_fee = 1000000
  }

  private fn _only_owner() {
    require(caller == self.owner, "xuperfactory: only the owner")
  }

  private fn _spawn(
    name: string,
    symbol: string,
    max_supply: u128,
    royalty_bps: u128,
    unrevealed_uri: string,
    provenance: string,
    base_uri: string,
    reveal_epoch: u128,
    sale: string,
    creator: address,
    payout: address,
    launcher: address,
    launcher_until: u128,
    platform: address,
    xlist: address,
    xpectra: address
  ): address {
    return deploy(XCOLLECTION_BYTECODE, name, symbol, max_supply, royalty_bps, unrevealed_uri, provenance,
      base_uri, reveal_epoch, sale, creator, payout, launcher, launcher_until,
      platform, xlist, xpectra)
  }

  //| Create a collection.
  //|
  //| who      the creator, who signs the creation
  //| pays     exactly the launch fee plus budget; the fee stays here and the budget goes to the launch key in the same transaction
  //| reveals  every setting of the new collection
  //| logs     CollectionCreated(index, collection, owner, launcher, fee, budget), after the collection's own PhaseSet, SaleSet and Initialized
  //| in       tag              "xf6", refused otherwise
  //| in       name             collection name
  //| in       symbol           collection symbol
  //| in       max_supply       the most tokens that can ever be minted, above zero
  //| in       royalty_bps      royalty in basis points, at most 1000
  //| in       unrevealed_uri   the placeholder metadata document
  //| in       provenance       the provenance hash, or empty to set it later
  //| in       base_uri         the revealed base uri, or empty to set it later
  //| in       reveal_epoch     the epoch the reveal takes effect, or 0 for none yet
  //| in       sale             the sale as Xcollection.configure_sale takes it, or empty to set it later
  //| in       creator          the collection owner, which is the caller
  //| in       payout           where proceeds and royalties are paid
  //| in       launcher         the launch key; pass the creator with launcher_until 0 for none
  //| in       launcher_until   the epoch the launch key's rights end
  //| in       budget           micro-OCT forwarded to the launch key for storage and setup fees
  //| out      the new collection's address
  payable fn create_collection(
    tag: string,
    name: string,
    symbol: string,
    max_supply: u128,
    royalty_bps: u128,
    unrevealed_uri: string,
    provenance: string,
    base_uri: string,
    reveal_epoch: u128,
    sale: string,
    creator: address,
    payout: address,
    launcher: address,
    launcher_until: u128,
    budget: u128
  ): address {
    require(tag == "xf6", "xuperfactory: this factory takes the xf6 argument list")
    require(caller == creator, "xuperfactory: the creator signs the creation")
    let fee: u128 = self.launch_fee
    require(value == fee + budget, "xuperfactory: send exactly the launch fee plus the budget")

    let coll: address = _spawn(name, symbol, max_supply, royalty_bps, unrevealed_uri, provenance,
      base_uri, reveal_epoch, sale, creator, payout, launcher, launcher_until,
      self.platform, self.xlist, self.xpectra)

    let idx: u128 = self.count
    self.collections[idx] = coll
    self.count = idx + 1
    let mine: u128 = self.count_of[creator]
    self.collection_of[creator][mine] = coll
    self.count_of[creator] = mine + 1
    if launcher_until > 0 { self.by_launcher[creator][launcher] = coll }

    if budget > 0 {
      require(transfer(launcher, budget), "xuperfactory: budget transfer failed")
    }
    emit CollectionCreated(idx, coll, creator, launcher, fee, budget)
    return coll
  }

  //| Send every launch fee held to the platform address.
  //|
  //| who      the owner or the platform address
  //| pays     the whole balance to the platform address
  //| out      true
  fn withdraw(): bool {
    require(caller == self.owner || caller == self.platform, "xuperfactory: only the owner or the platform")
    let amount: u128 = balance(self_addr)
    require(amount > 0, "xuperfactory: nothing to withdraw")
    require(transfer(self.platform, amount), "xuperfactory: withdraw transfer failed")
    return true
  }

  //| Set the launch fee for collections created from now on.
  //|
  //| who      the owner
  //| logs     LaunchFeeSet(fee)
  //| in       fee  micro-OCT; zero makes launching free
  //| out      true
  fn set_launch_fee(fee: u128): bool {
    _only_owner()
    self.launch_fee = fee
    emit LaunchFeeSet(fee)
    return true
  }

  //| Set the platform address given to collections created from now on.
  //|
  //| who      the owner
  //| logs     PlatformSet(platform)
  //| in       to  the new platform address
  //| out      true
  fn set_platform(to: address): bool {
    _only_owner()
    assert_address(to)
    self.platform = to
    emit PlatformSet(to)
    return true
  }

  //| Set the list contract given to collections created from now on.
  //|
  //| who      the owner
  //| logs     XlistSet(xlist)
  //| in       to  the new Xlist address
  //| out      true
  fn set_xlist(to: address): bool {
    _only_owner()
    assert_address(to)
    self.xlist = to
    emit XlistSet(to)
    return true
  }

  //| Offer the factory to another owner, who takes it with accept_ownership.
  //|
  //| who      the owner
  //| holds    nothing changes until the proposed owner accepts; proposing the owner withdraws an offer
  //| logs     OwnershipProposed(owner, proposed)
  //| in       to  the proposed owner
  //| out      true
  fn propose_ownership(to: address): bool {
    _only_owner()
    assert_address(to)
    self.pending_owner = to
    emit OwnershipProposed(self.owner, to)
    return true
  }

  //| Take the factory as its proposed owner.
  //|
  //| who      the proposed owner, while an offer is open
  //| holds    the offer is spent, so the previous owner keeps no claim
  //| logs     OwnershipTransferred(old_owner, new_owner)
  //| out      true
  fn accept_ownership(): bool {
    require(caller == self.pending_owner, "xuperfactory: only the proposed owner")
    require(caller != self.owner, "xuperfactory: no ownership offer is open")
    let old: address = self.owner
    self.owner = caller
    emit OwnershipTransferred(old, caller)
    return true
  }

  //| A collection by creation order.
  //| in       index  0 for the first collection created
  //| out      its address
  view fn get_collection(index: u128): address {
    return self.collections[index]
  }

  //| A collection by its creator.
  //| in       creator  the address named as owner at creation
  //| in       index    0 for that creator's first collection
  //| out      count|address, where count is how many that creator has made
  view fn collection_by_creator(creator: address, index: u128): string {
    return concat(concat(to_string(self.count_of[creator]), "|"), to_string(self.collection_of[creator][index]))
  }

  //| The collection a creator made with a launch key.
  //| in       creator   the address named as owner at creation
  //| in       launcher  the launch key
  //| out      the collection's address, or "0" when that creator never named that key
  view fn collection_by_launcher(creator: address, launcher: address): address {
    return self.by_launcher[creator][launcher]
  }
}
