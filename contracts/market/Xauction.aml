// SPDX-License-Identifier: FSL-1.1-MIT

//| Xauction
//| Sealed-bid, first-price auctions for single NFTs.
//|
//| model    three phases: bidding, posting and payment; the highest posted bid at or above min_bid wins and pays its own price
//| custody  the token is held by this contract from creation until it is paid for or reclaimed, and every bid holds the same bond here until the auction resolves
//| payout   payment, bonds and proceeds are credited and withdrawn with claim_proceeds; an unpaid win gives the winner's bond to the seller and the runner-up the chance to pay
//| privacy  a bid is a sha256 commitment, so its amount is hidden until it is posted; bidders, bonds and the number of bids are public
//| units    amounts in micro-OCT (1 OCT = 1,000,000), time in epochs
//| version  5.0.0
//| license  FSL-1.1-MIT, MIT from 2028-10-02

contract Xauction_v2 {

  const MARKETPLACE_FEE_BPS: u128 = 250
  const MAX_ROYALTY_BPS:     u128 = 1000
  const MIN_BOND:            u128 = 100000
  const MAX_BOND:            u128 = 1000000000
  const BOND_FLOOR_BPS:      u128 = 500
  const MAX_MIN_BID:         u128 = 1000000000000000000000000
  const MAX_PHASE_EPOCHS:    u128 = 518400
  const MIN_PHASE_EPOCHS:    u128 = 1
  // six hours and twenty four hours at the mainnet epoch rate
  const MIN_POSTING_EPOCHS:   u128 = 2144
  const MIN_PAYMENT_EPOCHS:   u128 = 8575
  const MAX_ALLOW_BATCH:     u128 = 100
  const MAX_POINTER_LEN:     u128 = 256

  state {
    owner:          address
    auction_count:  u128
    fee_balance:    u128
    reserve:        u128
    total_volume:   u128

    pending_proceeds: map[string]u128

    auction_seller:   map[u128]address
    auction_contract: map[u128]address
    auction_token_id: map[u128]u128
    auction_bond:     map[u128]u128
    auction_min_bid:  map[u128]u128

    // 0 open, 1 allowlist only
    auction_gated:      map[u128]u128
    auction_gate_salt:  map[u128]string
    auction_allow_size: map[u128]u128
    auction_allow:      map[u128]map[string]u128
    // 1 bidding, 2 posting, 3 awaiting payment, 4 paid, 5 void
    auction_status:   map[u128]u128
    // 1 while the token sits in this contract
    auction_asset_held: map[u128]u128

    auction_bidding_end: map[u128]u128
    auction_posting_end: map[u128]u128
    auction_payment_end: map[u128]u128
    auction_payment_len: map[u128]u128

    auction_bids: map[u128]u128
    auction_posted: map[u128]u128

    auction_top_bid:       map[u128]u128
    auction_top_bidder:    map[u128]address
    auction_second_bid:    map[u128]u128
    auction_second_bidder: map[u128]address

    auction_winner:  map[u128]address
    auction_price:   map[u128]u128
    auction_defaults: map[u128]u128

    bid_commit: map[u128]map[address]string
    bid_bond:   map[u128]map[address]u128
    bid_amount: map[u128]map[address]u128
    // 0 none, 1 bid placed, 2 bid posted, 3 bond resolved
    bid_state:  map[u128]map[address]u128
    bid_pointer: map[u128]map[address]string

    standard_mode: map[address]u128

    event_log:       map[u128]string
    event_log_count: u128
  }

  constructor() {
    self.owner = caller
  }

  private fn _log(entry: string) {
    self.event_log[self.event_log_count] = entry
    self.event_log_count += 1
  }

  private fn _credit(recipient: string, amount: u128) {
    let np: u128 = self.pending_proceeds[recipient] + amount
    require(np >= self.pending_proceeds[recipient], "xauction: proceeds overflow")
    self.pending_proceeds[recipient] = np
  }

  private fn _take(amount: u128) {
    let nr: u128 = self.reserve + amount
    require(nr >= self.reserve, "xauction: reserve overflow")
    self.reserve = nr
  }

  private fn _release(amount: u128) {
    require(self.reserve >= amount, "xauction: reserve underflow")
    self.reserve -= amount
  }

  private fn _digest(auction_id: u128, bidder: address, amount: u128, blinding: string): string {
    let pre: string = concat("xauction-v2|", to_string(self_addr))
    pre = concat(pre, "|")
    pre = concat(pre, to_string(auction_id))
    pre = concat(pre, "|")
    pre = concat(pre, to_string(bidder))
    pre = concat(pre, "|")
    pre = concat(pre, blinding)
    pre = concat(pre, "|")
    pre = concat(pre, to_string(amount))
    return sha256(pre)
  }

  //| Commitment for a bid, sha256("xauction-v2|" + contract + "|" + auction_id + "|" + bidder + "|" + blinding + "|" + amount).
  //| in       auction_id  the auction
  //| in       bidder      the bidder
  //| in       amount      the bid
  //| in       blinding    secret chosen by the bidder
  //| out      hex digest
  view fn preview_digest(auction_id: u128, bidder: address, amount: u128, blinding: string): string {
    return _digest(auction_id, bidder, amount, blinding)
  }

  private fn _gate_digest(auction_id: u128, who: address): string {
    let pre: string = concat("xauction-gate|", self.auction_gate_salt[auction_id])
    pre = concat(pre, "|")
    pre = concat(pre, to_string(who))
    return sha256(pre)
  }

  //| Allowlist digest of an address for an auction, sha256("xauction-gate|" + salt + "|" + address).
  //| in       auction_id  the auction
  //| in       who         the address
  //| out      hex digest
  view fn preview_gate_digest(auction_id: u128, who: address): string {
    return _gate_digest(auction_id, who)
  }

  private fn _check_is_owner(nft_contract: address, token_id: u128, addr: address): u128 {
    let current_owner: string = call(nft_contract, "owner_of", token_id)
    require(to_string(addr) == current_owner, "xauction: not token owner")
    return 1
  }

  private fn _check_approved(nft_contract: address, token_id: u128, addr: address): u128 {
    if self.standard_mode[nft_contract] == 1 {
      let current_owner: string = call(nft_contract, "owner_of", token_id)
      if to_string(addr) == current_owner { return 1 }
      let approved_addr: string = call(nft_contract, "get_approved", token_id)
      require(to_string(addr) == approved_addr, "xauction: not approved or owner")
      return 1
    }
    let approved: string = call(nft_contract, "is_approved_or_owner", token_id, addr)
    require(to_int(approved) == 1, "xauction: not approved or owner")
    return 1
  }

  private fn _send_asset(auction_id: u128, to: address) {
    require(self.auction_asset_held[auction_id] == 1, "xauction: asset not held")
    self.auction_asset_held[auction_id] = 0
    let nft_contract = self.auction_contract[auction_id]
    let token_id     = self.auction_token_id[auction_id]
    call(nft_contract, "transfer_from", self_addr, to, token_id)
    let now_owner: string = call(nft_contract, "owner_of", token_id)
    require(to_string(to) == now_owner, "xauction: nft transfer failed")
  }

  //| Creates an auction and takes the token into escrow.
  //| who      the token's owner, who has approved this contract for it
  //| holds    the token moves into this contract
  //| reveals  the seller, the token and every auction term
  //| logs     acreate|id|seller|nft|token_id|min_bid|bond|bidding_end|posting_end|epoch
  //| in       nft_contract    collection address
  //| in       token_id        token
  //| in       min_bid         lowest bid that can win
  //| in       bond            deposit every bidder attaches, at least 5% of min_bid
  //| in       bidding_epochs  length of the bidding phase
  //| in       posting_epochs  length of the posting phase, at least 2144
  //| in       payment_epochs  time the winner has to pay, at least 8575
  //| in       gated           1 for allowlisted bidders only, which refuses every bid until add_allow loads the list
  //| out      auction id
  fn create_auction(nft_contract: address, token_id: u128, min_bid: u128, bond: u128,
                    bidding_epochs: u128, posting_epochs: u128, payment_epochs: u128,
                    gated: u128): u128 {
    require(gated <= 1, "xauction: gate flag must be 0 or 1")
    require(bond >= MIN_BOND && bond <= MAX_BOND, "xauction: bad bond")
    require(min_bid <= MAX_MIN_BID, "xauction: floor too high")
    require(bond * 10000 >= min_bid * BOND_FLOOR_BPS, "xauction: bond too small for floor")
    require(bidding_epochs >= MIN_PHASE_EPOCHS && bidding_epochs <= MAX_PHASE_EPOCHS, "xauction: bad bidding window")
    require(posting_epochs >= MIN_POSTING_EPOCHS && posting_epochs <= MAX_PHASE_EPOCHS, "xauction: bad posting window")
    require(payment_epochs >= MIN_PAYMENT_EPOCHS && payment_epochs <= MAX_PHASE_EPOCHS, "xauction: bad payment window")

    _check_is_owner(nft_contract, token_id, caller)
    _check_approved(nft_contract, token_id, self_addr)

    let id: u128 = self.auction_count
    self.auction_count += 1

    self.auction_seller[id]   = caller
    self.auction_contract[id] = nft_contract
    self.auction_token_id[id] = token_id
    self.auction_bond[id]     = bond
    self.auction_min_bid[id]  = min_bid
    self.auction_status[id]   = 1
    self.auction_gated[id]    = gated

    self.auction_bidding_end[id] = epoch + bidding_epochs
    self.auction_posting_end[id] = epoch + bidding_epochs + posting_epochs
    self.auction_payment_len[id] = payment_epochs

    call(nft_contract, "transfer_from", caller, self_addr, token_id)
    let held_by: string = call(nft_contract, "owner_of", token_id)
    require(to_string(self_addr) == held_by, "xauction: escrow failed")
    self.auction_asset_held[id] = 1

    let entry = concat("acreate|", to_string(id))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(caller))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(nft_contract))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(token_id))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(min_bid))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(bond))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(self.auction_bidding_end[id]))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(self.auction_posting_end[id]))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(epoch))
    _log(entry)
    return id
  }

  //| Cancels an auction that has no bids.
  //| who      the seller
  //| holds    the token moves back to the seller
  //| reveals  that the auction was cancelled
  //| logs     acancel|id|seller|epoch
  //| in       auction_id  the auction
  //| out      true
  fn cancel_auction(auction_id: u128): bool {
    require(auction_id < self.auction_count, "xauction: bad auction id")
    require(caller == self.auction_seller[auction_id], "xauction: not the seller")
    require(self.auction_status[auction_id] == 1, "xauction: bidding is over")
    require(self.auction_bids[auction_id] == 0, "xauction: bids have already been placed")

    self.auction_status[auction_id] = 5
    _send_asset(auction_id, caller)

    let ev = concat("acancel|", to_string(auction_id))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(caller))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(epoch))
    _log(ev)
    return true
  }

  //| Adds allowlist entries to an auction.
  //| who      the seller
  //| reveals  the digests and their count, not the addresses
  //| logs     aallow|id|entries|epoch
  //| in       auction_id  the auction
  //| in       salt        salt the digests were made with, fixed by the first batch
  //| in       digests     comma-separated hex digests, at most 100
  //| out      true
  fn add_allow(auction_id: u128, salt: string, digests: string): bool {
    require(auction_id < self.auction_count, "xauction: bad auction id")
    require(caller == self.auction_seller[auction_id], "xauction: not the seller")
    require(self.auction_status[auction_id] == 1, "xauction: bidding is over")
    require(self.auction_bids[auction_id] == 0, "xauction: bids have already been placed")
    require(len(salt) > 0, "xauction: gate needs a salt")

    if self.auction_allow_size[auction_id] == 0 {
      self.auction_gate_salt[auction_id] = salt
    } else {
      require(salt == self.auction_gate_salt[auction_id], "xauction: salt does not match this allowlist")
    }

    let n: u128 = to_int(to_string(split(digests, ",")))
    require(n > 0 && n <= MAX_ALLOW_BATCH, "xauction: bad allowlist batch")
    for i in 0..n {
      let h: string = to_string(mget(100 + i))
      require(len(h) == 64, "xauction: bad digest")
      if self.auction_allow[auction_id][h] == 0 {
        self.auction_allow[auction_id][h] = 1
        self.auction_allow_size[auction_id] += 1
      }
    }

    let ev = concat("aallow|", to_string(auction_id))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(self.auction_allow_size[auction_id]))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(epoch))
    _log(ev)
    return true
  }

  //| Turns an auction's allowlist on or off.
  //| who      the seller
  //| when     before the first bid
  //| logs     agate|id|on|epoch
  //| in       auction_id  the auction
  //| in       on          1 for allowlist only, 0 for open
  //| out      true
  fn set_gate(auction_id: u128, on: u128): bool {
    require(auction_id < self.auction_count, "xauction: bad auction id")
    require(caller == self.auction_seller[auction_id], "xauction: not the seller")
    require(self.auction_status[auction_id] == 1, "xauction: bidding is over")
    require(self.auction_bids[auction_id] == 0, "xauction: bids have already been placed")
    require(on <= 1, "xauction: gate flag must be 0 or 1")
    if on == 1 {
      require(self.auction_allow_size[auction_id] > 0, "xauction: allowlist is empty")
    }
    self.auction_gated[auction_id] = on

    let ev = concat("agate|", to_string(auction_id))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(on))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(epoch))
    _log(ev)
    return true
  }

  //| Whether an address may bid on an auction.
  //| in       auction_id  the auction
  //| in       who         the address
  //| out      1 or 0
  view fn is_allowed(auction_id: u128, who: address): u128 {
    if self.auction_gated[auction_id] == 0 { return 1 }
    let h: string = _gate_digest(auction_id, who)
    return self.auction_allow[auction_id][h]
  }

  //| Allowlist settings of an auction.
  //| in       auction_id  the auction
  //| out      gated|entries|salt
  view fn get_gate(auction_id: u128): string {
    let s = concat(to_string(self.auction_gated[auction_id]), "|")
    s = concat(s, to_string(self.auction_allow_size[auction_id]))
    s = concat(s, "|")
    s = concat(s, self.auction_gate_salt[auction_id])
    return s
  }

  //| Places a sealed bid that the bidder will post themselves.
  //| who      anyone but the seller, once per auction, and only allowlisted addresses when the auction is gated
  //| pays     exactly the auction's bond
  //| when     during bidding
  //| reveals  the bidder and the bond, not the amount
  //| logs     abid|id|bidder|epoch|
  //| in       auction_id  the auction
  //| in       commitment  hex digest from preview_digest
  //| out      true
  fn place_bid(auction_id: u128, commitment: string): bool {
    return place_bid_sealed(auction_id, commitment, "")
  }

  //| Places a sealed bid and records where its opening is stored, so anyone can post it later.
  //| who      anyone but the seller, once per auction, and only allowlisted addresses when the auction is gated
  //| pays     exactly the auction's bond
  //| when     during bidding
  //| reveals  the bidder, the bond and the pointer, not the amount
  //| logs     abid|id|bidder|epoch|pointer
  //| in       auction_id  the auction
  //| in       commitment  hex digest from preview_digest
  //| in       pointer     where the opening is stored, at most 256 bytes, never read by this contract
  //| out      true
  fn place_bid_sealed(auction_id: u128, commitment: string, pointer: string): bool {
    require(auction_id < self.auction_count, "xauction: bad auction id")
    require(self.auction_status[auction_id] == 1, "xauction: bidding is over")
    require(epoch <= self.auction_bidding_end[auction_id], "xauction: bidding has closed")
    require(caller != self.auction_seller[auction_id], "xauction: seller cannot bid")
    require(self.bid_state[auction_id][caller] == 0, "xauction: already bid on this auction")
    require(len(commitment) == 64, "xauction: commitment must be a sha256 hex digest")
    require(len(pointer) <= MAX_POINTER_LEN, "xauction: pointer too long")

    if self.auction_gated[auction_id] == 1 {
      let gate: string = _gate_digest(auction_id, caller)
      require(self.auction_allow[auction_id][gate] == 1, "xauction: not on the allowlist")
    }

    let bond: u128 = self.auction_bond[auction_id]
    require(value == bond, "xauction: bond must match exactly")
    _take(value)

    self.bid_commit[auction_id][caller]  = commitment
    self.bid_bond[auction_id][caller]    = value
    self.bid_state[auction_id][caller]   = 1
    self.bid_pointer[auction_id][caller] = pointer
    self.auction_bids[auction_id] += 1

    let entry = concat("abid|", to_string(auction_id))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(caller))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(epoch))
    entry = concat(entry, "|")
    entry = concat(entry, pointer)
    _log(entry)
    return true
  }

  //| Pointer a bidder stored with place_bid_sealed.
  //| in       auction_id  the auction
  //| in       bidder      the bidder
  //| out      pointer, empty if none
  view fn get_bid_pointer(auction_id: u128, bidder: address): string {
    return self.bid_pointer[auction_id][bidder]
  }

  private fn _post(auction_id: u128, bidder: address, amount: u128, blinding: string) {
    require(auction_id < self.auction_count, "xauction: bad auction id")
    require(self.auction_status[auction_id] <= 2, "xauction: auction closed")
    require(epoch > self.auction_bidding_end[auction_id], "xauction: posting is not open yet")
    require(epoch <= self.auction_posting_end[auction_id], "xauction: posting window closed")
    require(self.bid_state[auction_id][bidder] == 1, "xauction: no bid to post")

    let expect: string = self.bid_commit[auction_id][bidder]
    require(_digest(auction_id, bidder, amount, blinding) == expect, "xauction: bid does not match the commitment")

    self.auction_status[auction_id] = 2
    self.bid_amount[auction_id][bidder] = amount
    self.bid_state[auction_id][bidder]  = 2
    self.auction_posted[auction_id] += 1

    if amount >= self.auction_min_bid[auction_id] {
      if amount > self.auction_top_bid[auction_id] {
        self.auction_second_bid[auction_id]    = self.auction_top_bid[auction_id]
        self.auction_second_bidder[auction_id] = self.auction_top_bidder[auction_id]
        self.auction_top_bid[auction_id]       = amount
        self.auction_top_bidder[auction_id]    = bidder
      } else {
        if amount > self.auction_second_bid[auction_id] {
          self.auction_second_bid[auction_id]    = amount
          self.auction_second_bidder[auction_id] = bidder
        }
      }
    }

    let entry = concat("apost|", to_string(auction_id))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(bidder))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(amount))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(epoch))
    _log(entry)
  }

  //| Posts the caller's bid by opening its commitment.
  //| who      a bidder with an unposted bid
  //| when     during posting
  //| reveals  the amount
  //| logs     apost|id|bidder|amount|epoch
  //| in       auction_id  the auction
  //| in       amount      the bid
  //| in       blinding    blinding used in the commitment
  //| out      true
  fn post_bid(auction_id: u128, amount: u128, blinding: string): bool {
    _post(auction_id, caller, amount, blinding)
    return true
  }

  //| Posts another bidder's bid by opening its commitment.
  //| who      anyone
  //| when     during posting
  //| reveals  the amount
  //| logs     apost|id|bidder|amount|epoch
  //| in       auction_id  the auction
  //| in       bidder      the bidder whose commitment is opened
  //| in       amount      the bid
  //| in       blinding    blinding used in the commitment
  //| out      true
  fn post_bid_for(auction_id: u128, bidder: address, amount: u128, blinding: string): bool {
    _post(auction_id, bidder, amount, blinding)
    return true
  }

  //| Closes the auction and fixes the winner and the price.
  //| who      anyone
  //| when     after posting, or after bidding once every bid is posted
  //| reveals  the winner and the price
  //| logs     aclose|id|winner|price|payment_end|epoch, or avoid|id|no_bids|epoch
  //| in       auction_id  the auction
  //| out      true
  fn close_auction(auction_id: u128): bool {
    require(auction_id < self.auction_count, "xauction: bad auction id")
    require(self.auction_status[auction_id] <= 2, "xauction: auction already closed")

    if epoch <= self.auction_posting_end[auction_id] {
      require(epoch > self.auction_bidding_end[auction_id], "xauction: posting is not open yet")
      require(self.auction_bids[auction_id] > 0, "xauction: no bids")
      require(self.auction_posted[auction_id] == self.auction_bids[auction_id], "xauction: bids still unposted")
    }

    let top: u128 = self.auction_top_bid[auction_id]

    if top == 0 {
      self.auction_status[auction_id] = 5
      let ev = concat("avoid|", to_string(auction_id))
      ev = concat(ev, "|no_bids|")
      ev = concat(ev, to_string(epoch))
      _log(ev)
      return true
    }

    self.auction_winner[auction_id] = self.auction_top_bidder[auction_id]
    self.auction_price[auction_id]  = top
    self.auction_status[auction_id] = 3
    self.auction_payment_end[auction_id] = epoch + self.auction_payment_len[auction_id]

    let entry = concat("aclose|", to_string(auction_id))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(self.auction_top_bidder[auction_id]))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(top))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(self.auction_payment_end[auction_id]))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(epoch))
    _log(entry)
    return true
  }

  private fn _payout(auction_id: u128, buyer: address, price: u128) {
    let nft_contract = self.auction_contract[auction_id]
    let token_id     = self.auction_token_id[auction_id]
    let seller       = self.auction_seller[auction_id]

    let creator: string      = call(nft_contract, "creator_of", token_id)
    let royalty_raw: string  = call(nft_contract, "royalty_of", token_id)
    let safe_royalty: u128   = to_int(royalty_raw)
    if safe_royalty > MAX_ROYALTY_BPS { safe_royalty = MAX_ROYALTY_BPS }

    let fee     = price * MARKETPLACE_FEE_BPS / 10000
    let royalty = price * safe_royalty / 10000
    require(fee + royalty <= price, "xauction: fee+royalty exceed price")
    let seller_cut = price - fee - royalty

    _credit(to_string(seller), seller_cut)
    _credit(creator, royalty)
    let nfb: u128 = self.fee_balance + fee
    require(nfb >= self.fee_balance, "xauction: fee overflow")
    self.fee_balance = nfb

    _release(price)
    let ntv: u128 = self.total_volume + price
    require(ntv >= self.total_volume, "xauction: volume overflow")
    self.total_volume = ntv

    self.auction_status[auction_id] = 4

    _send_asset(auction_id, buyer)

    let entry = concat("apay|", to_string(auction_id))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(buyer))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(seller))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(nft_contract))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(token_id))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(price))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(epoch))
    _log(entry)
  }

  //| Pays for a won auction and receives the token.
  //| who      the winner
  //| pays     at least the price, any excess returned; the price is credited to the seller, the creator and the fee, and the bond is credited back
  //| when     until the payment deadline
  //| holds    the token moves to the winner
  //| reveals  the payment
  //| logs     apay|id|buyer|seller|nft|token_id|price|epoch
  //| in       auction_id  the auction
  //| out      true
  fn pay(auction_id: u128): bool {
    require(auction_id < self.auction_count, "xauction: bad auction id")
    require(self.auction_status[auction_id] == 3, "xauction: not awaiting payment")
    require(caller == self.auction_winner[auction_id], "xauction: not the winner")
    require(epoch <= self.auction_payment_end[auction_id], "xauction: payment window closed")

    let price: u128 = self.auction_price[auction_id]
    require(value >= price, "xauction: insufficient payment")
    _take(value)

    _payout(auction_id, caller, price)

    let bond: u128 = self.bid_bond[auction_id][caller]
    if bond > 0 {
      self.bid_bond[auction_id][caller]  = 0
      self.bid_state[auction_id][caller] = 3
      _release(bond)
      _credit(to_string(caller), bond)
    }

    if value > price {
      _release(value - price)
      let rok: bool = transfer(caller, value - price)
      require(rok, "xauction: refund failed")
    }
    return true
  }

  //| Ends an unpaid win.
  //| who      anyone
  //| when     after the payment deadline
  //| pays     the winner's bond is credited to the seller
  //| reveals  the default, and the runner-up when there is one
  //| logs     adefault|id|bidder|bond|epoch, then apromote|id|bidder|price|epoch or avoid|id|winner_defaulted|epoch
  //| in       auction_id  the auction
  //| out      true
  fn default_winner(auction_id: u128): bool {
    require(auction_id < self.auction_count, "xauction: bad auction id")
    require(self.auction_status[auction_id] == 3, "xauction: not awaiting payment")
    require(epoch > self.auction_payment_end[auction_id], "xauction: payment window still open")

    let loser: address = self.auction_winner[auction_id]
    let bond: u128 = self.bid_bond[auction_id][loser]
    if bond > 0 {
      self.bid_bond[auction_id][loser]  = 0
      self.bid_state[auction_id][loser] = 3
      _release(bond)
      _credit(to_string(self.auction_seller[auction_id]), bond)
    }
    self.auction_defaults[auction_id] += 1

    let ev = concat("adefault|", to_string(auction_id))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(loser))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(bond))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(epoch))
    _log(ev)

    let runner: address = self.auction_second_bidder[auction_id]
    let runner_bid: u128 = self.auction_second_bid[auction_id]
    if runner_bid > 0 {
      self.auction_winner[auction_id] = runner
      self.auction_price[auction_id]  = runner_bid
      self.auction_second_bid[auction_id] = 0
      self.auction_payment_end[auction_id] = epoch + self.auction_payment_len[auction_id]

      let ev2 = concat("apromote|", to_string(auction_id))
      ev2 = concat(ev2, "|")
      ev2 = concat(ev2, to_string(runner))
      ev2 = concat(ev2, "|")
      ev2 = concat(ev2, to_string(runner_bid))
      ev2 = concat(ev2, "|")
      ev2 = concat(ev2, to_string(epoch))
      _log(ev2)
      return true
    }

    self.auction_status[auction_id] = 5
    let ev3 = concat("avoid|", to_string(auction_id))
    ev3 = concat(ev3, "|winner_defaulted|")
    ev3 = concat(ev3, to_string(epoch))
    _log(ev3)
    return true
  }

  //| Returns the token of a void auction to its seller.
  //| who      the seller
  //| holds    the token moves back to the seller
  //| logs     areclaim|id|seller|token_id|epoch
  //| in       auction_id  the auction
  //| out      true
  fn reclaim_asset(auction_id: u128): bool {
    require(auction_id < self.auction_count, "xauction: bad auction id")
    require(caller == self.auction_seller[auction_id], "xauction: not the seller")
    require(self.auction_status[auction_id] == 5, "xauction: auction not void")

    _send_asset(auction_id, caller)

    let ev = concat("areclaim|", to_string(auction_id))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(caller))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(self.auction_token_id[auction_id]))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(epoch))
    _log(ev)
    return true
  }

  //| Credits a posted bid's bond back to its bidder.
  //| who      a bidder whose bid was posted and who is not the paying winner
  //| when     once the auction is paid or void
  //| pays     the bond is credited to the caller
  //| logs     arefund|id|bidder|bond|epoch
  //| in       auction_id  the auction
  //| out      true
  fn claim_bond(auction_id: u128): bool {
    require(auction_id < self.auction_count, "xauction: bad auction id")
    let st: u128 = self.auction_status[auction_id]
    require(st == 4 || st == 5, "xauction: auction not resolved")
    require(caller != self.auction_winner[auction_id] || st == 5, "xauction: the winner pays instead")

    let bond: u128 = self.bid_bond[auction_id][caller]
    require(bond > 0, "xauction: no bond")
    require(self.bid_state[auction_id][caller] == 2, "xauction: bid was never posted")

    self.bid_bond[auction_id][caller]  = 0
    self.bid_state[auction_id][caller] = 3
    _release(bond)
    _credit(to_string(caller), bond)

    let ev = concat("arefund|", to_string(auction_id))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(caller))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(bond))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(epoch))
    _log(ev)
    return true
  }

  //| Gives the bond of a bid that was never posted to the seller.
  //| who      anyone
  //| when     once the auction is paid or void
  //| pays     the bond is credited to the seller
  //| logs     aslash|id|bidder|bond|epoch
  //| in       auction_id  the auction
  //| in       bidder      the bidder whose bid was not posted
  //| out      true
  fn slash_unposted(auction_id: u128, bidder: address): bool {
    require(auction_id < self.auction_count, "xauction: bad auction id")
    let st: u128 = self.auction_status[auction_id]
    require(st == 4 || st == 5, "xauction: auction not resolved")
    require(self.bid_state[auction_id][bidder] == 1, "xauction: bid was posted")

    let bond: u128 = self.bid_bond[auction_id][bidder]
    require(bond > 0, "xauction: no bond")
    self.bid_bond[auction_id][bidder]  = 0
    self.bid_state[auction_id][bidder] = 3
    _release(bond)
    _credit(to_string(self.auction_seller[auction_id]), bond)

    let ev = concat("aslash|", to_string(auction_id))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(bidder))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(bond))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(epoch))
    _log(ev)
    return true
  }

  //| Withdraws the caller's credit: proceeds, royalties and bonds.
  //| who      any address with a credit
  //| pays     the full credit to the caller
  //| reveals  the amount withdrawn
  //| out      true
  fn claim_proceeds(): bool {
    let amount: u128 = self.pending_proceeds[to_string(caller)]
    require(amount > 0, "xauction: nothing to claim")
    self.pending_proceeds[to_string(caller)] = 0
    let ok: bool = transfer(caller, amount)
    require(ok, "xauction: payout failed")
    return true
  }

  //| Marks a collection that has no is_approved_or_owner, so it is checked with owner_of and get_approved instead.
  //| who      the contract owner
  //| in       nft_contract  collection address
  //| in       flag          1 to mark, 0 to unmark
  //| out      true
  fn set_standard_mode(nft_contract: address, flag: u128): bool {
    require(caller == self.owner, "xauction: not owner")
    self.standard_mode[nft_contract] = flag
    return true
  }

  //| Withdraws the accrued marketplace fees.
  //| who      the contract owner
  //| pays     the fee balance to the recipient
  //| in       to  recipient
  //| out      true
  fn withdraw_fees(to: address): bool {
    require(caller == self.owner, "xauction: not owner")
    let amount: u128 = self.fee_balance
    require(amount > 0, "xauction: no fees")
    self.fee_balance = 0
    let ok: bool = transfer(to, amount)
    require(ok, "xauction: withdraw failed")
    return true
  }

  //| Major version.
  //| out      5
  view fn get_version(): u128 {
    return 5
  }

  //| Terms and state of an auction. status is 1 bidding, 2 posting, 3 awaiting payment, 4 paid, 5 void.
  //| in       auction_id  the auction
  //| out      status|seller|nft|token_id|min_bid|bond|bidding_end|posting_end|payment_end|held
  view fn get_auction(auction_id: u128): string {
    let s = concat(to_string(self.auction_status[auction_id]), "|")
    s = concat(s, to_string(self.auction_seller[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_contract[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_token_id[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_min_bid[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_bond[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_bidding_end[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_posting_end[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_payment_end[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_asset_held[auction_id]))
    return s
  }

  //| Ranking and outcome of an auction.
  //| in       auction_id  the auction
  //| out      top_bid|top_bidder|second_bid|second_bidder|winner|price
  view fn get_result(auction_id: u128): string {
    let s = concat(to_string(self.auction_top_bid[auction_id]), "|")
    s = concat(s, to_string(self.auction_top_bidder[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_second_bid[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_second_bidder[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_winner[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_price[auction_id]))
    return s
  }

  //| Bid counts of an auction.
  //| in       auction_id  the auction
  //| out      bids|posted|defaults
  view fn get_participation(auction_id: u128): string {
    let s = concat(to_string(self.auction_bids[auction_id]), "|")
    s = concat(s, to_string(self.auction_posted[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_defaults[auction_id]))
    return s
  }

  //| A bidder's bid. state is 0 none, 1 placed, 2 posted, 3 bond resolved; amount is 0 until posted.
  //| in       auction_id  the auction
  //| in       bidder      the bidder
  //| out      state|bond|amount|commitment
  view fn get_bid(auction_id: u128, bidder: address): string {
    let s = concat(to_string(self.bid_state[auction_id][bidder]), "|")
    s = concat(s, to_string(self.bid_bond[auction_id][bidder]))
    s = concat(s, "|")
    s = concat(s, to_string(self.bid_amount[auction_id][bidder]))
    s = concat(s, "|")
    s = concat(s, self.bid_commit[auction_id][bidder])
    return s
  }

  //| Credit an address can withdraw.
  //| in       who  the address
  //| out      amount
  view fn get_proceeds(who: address): u128 {
    return self.pending_proceeds[to_string(who)]
  }

  //| Entry i of the event log, from 0 to event_count - 1. Each writing function lists the entry it writes.
  //| in       i  entry index
  //| out      entry
  view fn get_event(i: u128): string {
    return self.event_log[i]
  }

  //| Contract totals. reserve is the value held for bonds, payments and credits.
  //| out      auction_count|event_count|reserve|fee_balance|total_volume
  view fn get_stats(): string {
    let s = concat(to_string(self.auction_count), "|")
    s = concat(s, to_string(self.event_log_count))
    s = concat(s, "|")
    s = concat(s, to_string(self.reserve))
    s = concat(s, "|")
    s = concat(s, to_string(self.fee_balance))
    s = concat(s, "|")
    s = concat(s, to_string(self.total_volume))
    return s
  }
}
